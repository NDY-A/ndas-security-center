<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Aegis.App</RootNamespace>
    <AssemblyName>NDAS</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\Aegis.ico</ApplicationIcon>
    <Description>NDAS local antivirus console built with WinUI 3.</Description>
    <Version>0.0.8.0</Version>
    <AssemblyVersion>0.0.8.0</AssemblyVersion>
    <FileVersion>0.0.8.0</FileVersion>
    <InformationalVersion>rs_preelease-0.0.8.0a</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Aegis.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Aegis.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSDKVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(WindowsSdkBuildToolsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aegis.Core\Aegis.Core.csproj" />
    <ProjectReference Include="..\Aegis.Agent\Aegis.Agent.csproj" />
    <ProjectReference Include="..\Aegis.Hips\Aegis.Hips.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\seed\**\*">
      <Link>Seed\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- WinUI 的 .pri 和 .xbf 默认只进 build 输出，publish 会漏掉，导致发布版 XAML 解析失败。 -->
  <Target Name="CopyWinUIResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIResourcesToPublish Include="$(TargetDir)$(AssemblyName).pri" />
      <_WinUIResourcesToPublish Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIResourcesToPublish)"
          DestinationFiles="@(_WinUIResourcesToPublish->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
