<Page
    x:Class="Aegis.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource AegisPagePadding}" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="威胁和防护状态" Style="{StaticResource AegisPageTitleStyle}" />
                    <TextBlock Text="查看本机威胁和防护状态，并运行按需扫描。"
                               Style="{StaticResource AegisSecondaryTextStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource AegisPillStyle}" VerticalAlignment="Top">
                    <TextBlock Text="按需防护" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>

            <Border x:Name="HeroCard" Grid.Row="1" Background="{StaticResource AegisHeroBrush}" CornerRadius="16" Padding="28" MinHeight="238">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="164" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="DEVICE STATUS" FontSize="11" CharacterSpacing="120"
                                   Foreground="{StaticResource AegisHeroSecondaryTextBrush}" />
                        <TextBlock x:Name="StatusTitle" Text="正在初始化安全引擎…" FontSize="28" FontWeight="SemiBold"
                                   Foreground="White" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusSubtitle" Text="正在加载本地病毒库和启发式规则。"
                                   Foreground="{StaticResource AegisHeroSecondaryTextBrush}" TextWrapping="Wrap"
                                   MaxWidth="720" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                            <Button Content="快速扫描" Click="QuickScan_Click" Background="White" Foreground="#0B3554"
                                    Padding="18,8" CornerRadius="6" />
                            <Button Content="检查安全智能更新" Click="CheckUpdates_Click" Background="#22FFFFFF"
                                    Foreground="White" BorderBrush="#55FFFFFF" Padding="18,8" CornerRadius="6" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" Width="140" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Fill="#22FFFFFF" />
                        <Viewbox Width="102" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="120" Height="132">
                                <Path Data="M60,4 L112,24 V58 C112,90 90,116 60,128 C30,116 8,90 8,58 V24 Z"
                                      Fill="#18FFFFFF" Stroke="#66FFFFFF" StrokeThickness="3" />
                                <Path x:Name="HeroCheck" Data="M36,64 L53,82 L86,44" Stroke="#7CF29B" StrokeThickness="9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path x:Name="HeroAlert" Data="M60,30 L60,76 M60,92 L60,98" Stroke="White" StrokeThickness="9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ContainmentCard" Grid.Row="2" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#C42B1C" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#FDE7E9" CornerRadius="999" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock Text="活动威胁" FontSize="11" FontWeight="SemiBold" Foreground="#8A1C10" />
                                </Border>
                                <TextBlock x:Name="ThreatTitleText" Text="检测到活动恶意软件"
                                           FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ThreatDetailText" Text="正在读取威胁信息…"
                                       Style="{StaticResource AegisCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button x:Name="ContainmentButton" Content="启动高威胁强力清除"
                                    Click="StartContainment_Click" Background="#C42B1C" Foreground="White"
                                    Padding="16,8" CornerRadius="6" />
                            <Button x:Name="AbortContainmentButton" Content="取消清除"
                                    Click="AbortContainment_Click" Padding="12,6" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="ContainmentProgressPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock x:Name="ContainmentPhaseText" Text="准备中…" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar x:Name="ContainmentProgressBar" IsIndeterminate="True" />
                        <TextBlock x:Name="ContainmentMetricsText" Style="{StaticResource AegisCaptionStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ContainmentActionText" Style="{StaticResource AegisCaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="ContainmentHintText"
                               Text="强力清除只针对正在运行的活动恶意软件。执行时会关闭当前会话中所有非系统必需进程（未保存的工作会丢失），持续清扫新进程，扫描系统关键位置，备份并修复一次引导，完成后强制关机；下次登录会自动打开 NDAS 并快速扫描。"
                               Style="{StaticResource AegisCaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AegisCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#E8F1FB">
                                <TextBlock Text="DB" FontSize="11" FontWeight="Bold" Foreground="#0F6CBD"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="安全智能" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="SignatureVersionText" Text="—" Style="{StaticResource AegisMetricStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SignatureCountsText" Text="正在读取…" Style="{StaticResource AegisCaptionStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource AegisCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#E6F4EA">
                                <TextBlock Text="☁" FontSize="16" Foreground="#107C10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="云安全" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="CloudStateText" Text="读取中" Style="{StaticResource AegisMetricStyle}" />
                        <TextBlock x:Name="CloudDetailText" Text="正在读取配置…" Style="{StaticResource AegisCaptionStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource AegisCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#F3E8FD">
                                <TextBlock Text="API" FontSize="10" FontWeight="Bold" Foreground="#7A3DB8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="自动化" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="AgentStateText" Text="读取中" Style="{StaticResource AegisMetricStyle}" />
                        <TextBlock x:Name="AgentEndpointText" Text="正在读取接口状态…" Style="{StaticResource AegisCaptionStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="ScanCard" Grid.Row="4" Style="{StaticResource AegisCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="扫描" Style="{StaticResource AegisSectionTitleStyle}" />
                        <TextBlock Text="哈希签名、启发式与云信誉三层检测，只读扫描，不自动处置文件。"
                                   Style="{StaticResource AegisCaptionStyle}" />
                    </StackPanel>

                    <RadioButtons x:Name="ProfileSelector" SelectedIndex="0" SelectionChanged="Profile_SelectionChanged">
                        <RadioButton Content="快速扫描（桌面、下载、临时目录、启动项）" Tag="quick" />
                        <RadioButton Content="完整扫描（本地固定磁盘）" Tag="full" />
                        <RadioButton Content="自定义路径" Tag="custom" />
                    </RadioButtons>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomPathBox" IsEnabled="False"
                                 PlaceholderText="选择要扫描的文件或文件夹" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…"
                                IsEnabled="False" Click="Browse_Click" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button x:Name="StartButton" Content="开始扫描" Click="StartScan_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="CancelButton" Content="取消" Click="CancelScan_Click" IsEnabled="False" />
                        <TextBlock x:Name="StatusText" Text="选择范围后开始扫描。"
                                   Style="{StaticResource AegisCaptionStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" Visibility="Collapsed" />
                    <TextBlock x:Name="ProgressTitle" Text="尚未开始" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProgressDetail" Text="等待启动扫描任务。"
                               Style="{StaticResource AegisCaptionStyle}" TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Spacing="30">
                        <StackPanel>
                            <TextBlock x:Name="FilesScannedText" Text="0" Style="{StaticResource AegisMetricStyle}" />
                            <TextBlock Text="已扫描文件" Style="{StaticResource AegisCaptionStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="DetectionsText" Text="0" Style="{StaticResource AegisMetricStyle}" />
                            <TextBlock Text="发现项" Style="{StaticResource AegisCaptionStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <InfoBar x:Name="ScanInfo" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource AegisCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="扫描结果" Style="{StaticResource AegisSectionTitleStyle}" />
                        <TextBlock x:Name="LastScanText" Text="尚未运行扫描。" Style="{StaticResource AegisCaptionStyle}" />
                    </StackPanel>

                    <ListView x:Name="ResultsList" SelectionMode="None" MaxHeight="420" Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="2,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding BadgeBackground}" CornerRadius="999" Padding="9,4" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding VerdictText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding BadgeForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FilePath}" Style="{StaticResource AegisCaptionStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource AegisCaptionStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ScoreText}" Style="{StaticResource AegisCaptionStyle}"
                                               VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding ActionsVisibility}">
                                            <Button Content="隔离" Click="QuarantineFinding_Click" Padding="10,4" FontSize="12" />
                                            <Button Content="删除" Click="DeleteFinding_Click" Padding="10,4" FontSize="12" />
                                            <Button Content="允许" Click="AllowFinding_Click" Padding="10,4" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ActionStatus}" Style="{StaticResource AegisCaptionStyle}"
                                                   Visibility="{Binding StatusVisibility}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border x:Name="EmptyResultsPanel" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="10" Padding="18">
                        <StackPanel Spacing="5">
                            <TextBlock Text="还没有发现项" FontWeight="SemiBold" />
                            <TextBlock Text="扫描完成后，命中的哈希、启发式规则和云判定会显示在这里。"
                                       Style="{StaticResource AegisCaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="扫描结果可执行隔离、删除或加入白名单；隔离文件可在“威胁和防护设置 &gt; 隔离区”还原。云查询只发送文件 SHA-256、大小和判定请求，不发送文件内容或本地路径。"
                               Style="{StaticResource AegisCaptionStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
