<Page
    x:Class="Aegis.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Aegis.App.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource AegisPagePadding}" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="主页" Style="{StaticResource AegisPageTitleStyle}" />
                    <TextBlock Text="查看本机威胁和防护状态，并运行按需扫描。"
                               Style="{StaticResource AegisSecondaryTextStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource AegisPillStyle}" VerticalAlignment="Top">
                    <TextBlock Text="按需防护" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>

            <Border x:Name="ContainmentCard" Grid.Row="1" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#C42B1C" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#FDE7E9" CornerRadius="999" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock Text="活动威胁" FontSize="11" FontWeight="SemiBold" Foreground="#8A1C10" />
                                </Border>
                                <TextBlock x:Name="ThreatTitleText" Text="检测到活动恶意软件"
                                           FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ThreatDetailText" Text="正在读取威胁信息…"
                                       Style="{StaticResource AegisCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button x:Name="ContainmentButton" Content="启动高威胁强力清除"
                                    Click="StartContainment_Click" Background="#C42B1C" Foreground="White"
                                    Padding="16,8" CornerRadius="6" />
                            <Button x:Name="AbortContainmentButton" Content="取消清除"
                                    Click="AbortContainment_Click" Padding="12,6" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="ContainmentProgressPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock x:Name="ContainmentPhaseText" Text="准备中…" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar x:Name="ContainmentProgressBar" IsIndeterminate="True" />
                        <TextBlock x:Name="ContainmentMetricsText" Style="{StaticResource AegisCaptionStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ContainmentActionText" Style="{StaticResource AegisCaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="ContainmentHintText"
                               Text="强力清除只针对正在运行的活动恶意软件。执行时会关闭当前会话中所有非系统必需进程（未保存的工作会丢失），持续清扫新进程，扫描系统关键位置，备份并修复一次引导，完成后强制关机；下次登录会自动打开 NDAS 并快速扫描。"
                               Style="{StaticResource AegisCaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <controls:CardWrapPanel Grid.Row="2" MinItemWidth="280" MaxColumns="4" Spacing="18" Tapped="StatusCard_Tapped">

                <Border Tag="scan" Style="{StaticResource AegisBigCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <Grid Width="46" Height="46" HorizontalAlignment="Left">
                                <controls:SimpleShieldIcon x:Name="ThreatIcon" Width="40" Height="40"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                                           Foreground="{ThemeResource AegisIconBrush}" />
                                <Border x:Name="ThreatStatusBadge" Width="18" Height="18" CornerRadius="999"
                                        Background="#107C10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        BorderBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="2">
                                    <FontIcon x:Name="ThreatStatusIcon" Glyph="&#xE73E;" FontSize="9" Foreground="White" />
                                </Border>
                            </Grid>
                            <TextBlock Text="病毒和威胁防护" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="StatusTitle" Text="正在初始化安全引擎…" FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="StatusSubtitle" Text="正在加载本地病毒库和启发式规则。"
                                       Style="{StaticResource AegisCaptionStyle}" />
                        </StackPanel>
                        <Button Grid.Row="1" Content="快速扫描" Click="QuickScan_Click"
                                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </Grid>
                </Border>

                <Border Tag="update" Style="{StaticResource AegisBigCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE895;" FontSize="40" HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AegisIconBrush}" />
                            <TextBlock Text="保护更新" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="SignatureVersionText" Text="—" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SignatureCountsText" Text="正在读取…" Style="{StaticResource AegisCaptionStyle}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Row="1" Content="检查更新" Click="NavigateUpdate_Click"
                                         Padding="0" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </Grid>
                </Border>

                <Border Tag="hips" Style="{StaticResource AegisBigCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE72E;" FontSize="40" HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AegisIconBrush}" />
                            <TextBlock Text="实时防护" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="RealtimeStateText" Text="—" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="RealtimeDetailText" Text="正在读取…" Style="{StaticResource AegisCaptionStyle}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Row="1" Content="管理设置" Click="NavigateHips_Click"
                                         Padding="0" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </Grid>
                </Border>

                <Border Tag="automation" Style="{StaticResource AegisBigCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE943;" FontSize="40" HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AegisIconBrush}" />
                            <TextBlock Text="自动化接口" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="AgentStateText" Text="读取中" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="AgentEndpointText" Text="正在读取接口状态…" Style="{StaticResource AegisCaptionStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <HyperlinkButton Grid.Row="1" Content="自动化接口" Click="NavigateAutomation_Click"
                                         Padding="0" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </Grid>
                </Border>

                <Border Tag="scan" Style="{StaticResource AegisBigCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="40" HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AegisIconBrush}" />
                            <TextBlock Text="扫描" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="BigScanText" Text="尚未运行扫描。" Style="{StaticResource AegisCaptionStyle}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Row="1" Content="打开扫描页面" Click="NavigateScan_Click"
                                         Padding="0" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </Grid>
                </Border>

                <Border Tag="history" Style="{StaticResource AegisBigCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="40" HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AegisIconBrush}" />
                            <TextBlock Text="保护历史" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="HistorySummaryText" Text="—" Style="{StaticResource AegisCaptionStyle}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Row="1" Content="查看事件" Click="NavigateHistory_Click"
                                         Padding="0" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </Grid>
                </Border>

                <Border Tag="hips" Style="{StaticResource AegisBigCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="40" HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AegisIconBrush}" />
                            <TextBlock Text="隔离区" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="BigQuarantineText" Text="—" Style="{StaticResource AegisCaptionStyle}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Row="1" Content="管理隔离区" Click="NavigateHips_Click"
                                         Padding="0" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </Grid>
                </Border>

                <Border Tag="update" Style="{StaticResource AegisBigCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE753;" FontSize="40" HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AegisIconBrush}" />
                            <TextBlock Text="云安全" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="CloudStateText" Text="读取中" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="CloudDetailText" Text="正在读取配置…" Style="{StaticResource AegisCaptionStyle}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Row="1" Content="配置云端" Click="NavigateUpdate_Click"
                                         Padding="0" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </Grid>
                </Border>
            </controls:CardWrapPanel>

        </Grid>
    </ScrollViewer>
</Page>
