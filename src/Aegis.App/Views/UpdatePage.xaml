<Page
    x:Class="Aegis.App.Views.UpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource AegisPagePadding}" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <HyperlinkButton Content="威胁和防护保护" Click="BreadcrumbRoot_Click"
                                     FontSize="30" FontWeight="SemiBold" Padding="0" MinWidth="0"
                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                     HorizontalContentAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock Text="›" FontSize="30" FontWeight="Light" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="保护更新" Style="{StaticResource AegisPageTitleStyle}" />
                </StackPanel>
                <TextBlock Text="查看有关安全智能版本的信息，并检查是否有更新。"
                           Style="{StaticResource AegisSecondaryTextStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource AegisCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="安全智能" Style="{StaticResource AegisSectionTitleStyle}" />
                    <TextBlock Text="NDAS 使用安全智能来检测威胁。应用会尝试自动下载最新的智能，以保护你的设备免受最新威胁的侵害。你也可以手动检查更新。"
                               Style="{StaticResource AegisSecondaryTextStyle}" />

                    <StackPanel Spacing="3">
                        <TextBlock x:Name="VersionText" Text="安全智能版本：—" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="CreatedText" Text="版本创建时间：—" Style="{StaticResource AegisCaptionStyle}" />
                        <TextBlock x:Name="LastUpdatedText" Text="上次更新时间：—" Style="{StaticResource AegisCaptionStyle}" />
                    </StackPanel>

                    <TextBlock x:Name="StateText" Text="读取中" Style="{StaticResource AegisCaptionStyle}" />
                    <TextBlock x:Name="CountsText" Text="—" Style="{StaticResource AegisCaptionStyle}" />
                    <TextBlock x:Name="SourceText" Text="—" Style="{StaticResource AegisCaptionStyle}" TextTrimming="CharacterEllipsis" />

                    <InfoBar x:Name="FreshnessInfo" IsOpen="False" IsClosable="False" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="UpdateButton" Content="检查更新" Click="Update_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" />
                        <TextBlock x:Name="StatusText" Text="尚未检查更新。"
                                   Style="{StaticResource AegisCaptionStyle}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    </StackPanel>

                    <ToggleSwitch x:Name="AutoUpdateToggle" Header="每 60 分钟自动检查"
                                  OffContent="关闭" OnContent="开启" Toggled="AutoUpdateToggle_Toggled" />
                    <TextBlock x:Name="LastCheckText" Text="尚未自动检查。"
                               Style="{StaticResource AegisCaptionStyle}" />

                    <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed" />
                    <InfoBar x:Name="UpdateInfo" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource AegisCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="第三方云安全服务" Style="{StaticResource AegisSectionTitleStyle}" />
                    <TextBlock Text="按策略把文件 SHA-256、大小和查询意图发送到你自己的云信誉服务；不发送文件内容或本地路径。"
                               Style="{StaticResource AegisSecondaryTextStyle}" />
                    <ToggleSwitch x:Name="CloudEnabledToggle" Header="启用云安全查询"
                                  OffContent="关闭" OnContent="开启" />
                    <TextBox x:Name="CloudEndpointBox" Header="服务端点"
                             PlaceholderText="https://cloud.example.com/api/reputation" />
                    <PasswordBox x:Name="CloudApiKeyBox" Header="API 密钥（留空保持不变）"
                                 PasswordRevealMode="Peek" />
                    <CheckBox x:Name="ClearCloudKeyCheck" Content="清除已保存的密钥" />
                    <TextBlock x:Name="CloudKeyStateText" Text="—" Style="{StaticResource AegisCaptionStyle}" />
                    <ComboBox x:Name="CloudPolicyBox" Header="查询策略" SelectedIndex="1" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="从不" Tag="Never" />
                        <ComboBoxItem Content="仅可疑文件" Tag="SuspiciousOnly" />
                        <ComboBoxItem Content="可执行文件与脚本" Tag="ExecutablesAndScripts" />
                        <ComboBoxItem Content="全部文件" Tag="All" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="保存云设置" Click="SaveCloud_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="测试云服务" Click="TestCloud_Click" />
                    </StackPanel>
                    <InfoBar x:Name="CloudInfo" IsOpen="False" IsClosable="True" />
                    <TextBlock Text="端点必须使用 HTTPS；只有本机回环地址允许 HTTP。密钥保存在本机 DPAPI 中。"
                               Style="{StaticResource AegisCaptionStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource AegisCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="下载源与校验" Style="{StaticResource AegisSectionTitleStyle}" />
                    <TextBlock Text="依次尝试 GitHub Raw、GitHub Web Raw、jsDelivr 与 jsDelivr CDN；只接受版本更新的定义，旧版本源会被跳过；下载内容限制在 16 MiB/文件，校验通过后才会替换当前定义，失败或超时保留旧版本并显示“无可用更新”。"
                               Style="{StaticResource AegisSecondaryTextStyle}" />
                    <TextBlock Text="更新需要访问 GitHub/CDN。若系统代理开启，请确保未把 raw.githubusercontent.com 或 cdn.jsdelivr.net 误拦。"
                               Style="{StaticResource AegisCaptionStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
