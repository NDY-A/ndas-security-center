<Window
    x:Class="Aegis.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView
            x:Name="Nav"
            PaneDisplayMode="Left"
            OpenPaneLength="244"
            CompactPaneLength="56"
            CompactModeThresholdWidth="760"
            ExpandedModeThresholdWidth="1080"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneOpen="True"
            SelectionChanged="Nav_SelectionChanged"
            Loaded="Nav_Loaded">

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,4,8,14">
                    <Image x:Name="BrandIcon" Width="38" Height="38" Stretch="Uniform"
                           Source="ms-appx:///Assets/Aegis.png" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="NDAS" FontSize="16" FontWeight="SemiBold" CharacterSpacing="80" />
                        <TextBlock Text="本地安全中心" Style="{StaticResource AegisCaptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="威胁和防护状态" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE83D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="保护更新" Tag="update">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="自动化接口" Tag="automation">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="威胁和防护设置" Tag="hips">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar
                    x:Name="GlobalInfo"
                    Grid.Row="0"
                    Margin="24,12,24,0"
                    IsOpen="False"
                    IsClosable="True" />
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
