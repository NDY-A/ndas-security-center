<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 安全中心（Defender）深色风格：深灰页面、深灰卡片、绿色强调色、蓝色状态图标。 -->

    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#202020" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#2F2F2F" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#383838" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#333333" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5DBB50" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4FA843" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0F1F0A" />

    <Color x:Key="SystemAccentColor">#6CCB5F</Color>
    <Color x:Key="SystemAccentColorDark1">#5DBB50</Color>
    <Color x:Key="SystemAccentColorDark2">#4FA843</Color>
    <Color x:Key="SystemAccentColorDark3">#3F8A36</Color>
    <Color x:Key="SystemAccentColorLight1">#86D67A</Color>
    <Color x:Key="SystemAccentColorLight2">#A0E196</Color>
    <Color x:Key="SystemAccentColorLight3">#BAECB2</Color>

    <SolidColorBrush x:Key="AegisAccentBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="AegisAccentDarkBrush" Color="#4FA843" />
    <SolidColorBrush x:Key="AegisAccentSoftBrush" Color="#1E3320" />
    <SolidColorBrush x:Key="AegisAccentTextBrush" Color="#86D67A" />
    <SolidColorBrush x:Key="AegisSuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="AegisSuccessSoftBrush" Color="#1E3A1E" />
    <SolidColorBrush x:Key="AegisSuccessTextBrush" Color="#9AE590" />
    <SolidColorBrush x:Key="AegisWarningBrush" Color="#FFC83D" />
    <SolidColorBrush x:Key="AegisWarningSoftBrush" Color="#3A3320" />
    <SolidColorBrush x:Key="AegisWarningTextBrush" Color="#FFE97A" />
    <SolidColorBrush x:Key="AegisDangerBrush" Color="#E81123" />
    <SolidColorBrush x:Key="AegisDangerSoftBrush" Color="#3B2224" />
    <SolidColorBrush x:Key="AegisDangerTextBrush" Color="#FFB3B8" />
    <SolidColorBrush x:Key="AegisDangerBannerBrush" Color="#4A1414" />
    <SolidColorBrush x:Key="AegisDangerIconBrush" Color="#FF5A5F" />
    <SolidColorBrush x:Key="AegisMutedBrush" Color="#A8A8A8" />

    <SolidColorBrush x:Key="AegisHeroOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AegisHeroTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AegisHeroSecondaryTextBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="AegisHeroTitleBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AegisHeroButtonBackgroundBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="AegisHeroButtonForegroundBrush" Color="#0F1F0A" />
    <SolidColorBrush x:Key="AegisHeroGhostBackgroundBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="AegisHeroGhostForegroundBrush" Color="#86D67A" />
    <SolidColorBrush x:Key="AegisHeroGhostBorderBrush" Color="#3F8A36" />
    <SolidColorBrush x:Key="AegisHeroShieldFillBrush" Color="#0E2A44" />
    <SolidColorBrush x:Key="AegisHeroShieldStrokeBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AegisHeroCheckBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="AegisHeroAlertBrush" Color="#FFC83D" />
    <SolidColorBrush x:Key="AegisIconBrush" Color="#4CC2FF" />

    <LinearGradientBrush x:Key="AegisHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C2C2C" Offset="0" />
        <GradientStop Color="#282A2E" Offset="0.62" />
        <GradientStop Color="#24282D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AegisDangerHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3A2022" Offset="0" />
        <GradientStop Color="#322226" Offset="0.62" />
        <GradientStop Color="#2B2B2B" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="AegisCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#2B2B2B" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="AegisBigCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#2B2B2B" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="MinHeight" Value="210" />
    </Style>
</ResourceDictionary>
